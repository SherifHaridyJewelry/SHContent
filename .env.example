# SHContent environment variables
# Copy to /etc/shcontent/.env on VPS (production) or .env locally (development)

# Database — SQLite fallback for local dev/CI; Postgres for production
DATABASE_URL=sqlite:///./data/shcontent.db
# DATABASE_URL=postgresql+psycopg2://shcontent:password@localhost/shcontent

APP_ENV=development
SECRET_KEY=dev-secret-change-in-production
API_KEY=

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Writable data root (defaults to project root in dev; /var/lib/shcontent in prod)
# DATA_ROOT=/var/lib/shcontent

# Image generation
KIE_API_KEY=

# Cloudflare R2
CF_ACCOUNT_ID=
CF_R2_ACCESS_KEY=
CF_R2_SECRET_KEY=
CF_R2_BUCKET=
CF_R2_PUBLIC_URL=
