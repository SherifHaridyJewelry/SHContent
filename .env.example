# SHContent environment variables
# Production: copy to /etc/shcontent/.env on VPS (never commit).
# Local dev: copy to .env in repo root.

# --- Production (Docker) ---
# POSTGRES_PASSWORD is required; compose builds DATABASE_URL from it.
# Do not set DATABASE_URL=sqlite in /etc/shcontent/.env — compose overrides for Postgres.
POSTGRES_PASSWORD=changeme

# --- Local development (SQLite) ---
DATABASE_URL=sqlite:///./data/shcontent.db

APP_ENV=development
SECRET_KEY=dev-secret-change-in-production
API_KEY=

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Writable data root (defaults to project root in dev; /data in Docker prod)
# DATA_ROOT=/data

# Image generation (also editable in the Settings UI)
KIE_API_KEY=

# Cloudflare R2 (also editable in the Settings UI)
CF_ACCOUNT_ID=
CF_R2_ACCESS_KEY=
CF_R2_SECRET_KEY=
CF_R2_BUCKET=
CF_R2_PUBLIC_URL=

# Optional pipeline defaults (also editable in Settings; stored in DB when changed)
# MAX_PARALLEL_PRODUCTS=3
